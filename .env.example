# ---- Aplicación ----
APP_NAME=Ratio
APP_TAGLINE=Diagnóstico jurídico adaptativo
# ---- Usuarios ----
# Administrador inicial (se crea al arrancar si no existe). CAMBIA la contraseña antes de la demo.
ADMIN_EMAIL=admin@ratio.local
# En producción la contraseña admin-demo NO funciona: define una propia (al arrancar reemplaza la de demostración).
ADMIN_PASSWORD=admin-demo
ADMIN_NAME=Administrador

# --- Envío del informe por correo (cuando queda verificado) ---
# Gmail: SMTP_PASSWORD es una "contraseña de aplicación" de 16 letras (myaccount.google.com/apppasswords),
# NO la contraseña normal. Requiere tener activada la verificación en dos pasos.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_FROM_NAME=Ratio
# Si el hosting bloquea SMTP (Render Free), envía por API HTTPS: MAIL_PROVIDER=brevo o resend,
# MAIL_API_KEY=<clave del proveedor> y MAIL_FROM=<remitente verificado en el proveedor>.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
# Correo para consultas y reclamos sobre datos personales (aparece en la política de privacidad).
CONTACT_EMAIL=
# Dirección con la que las personas abren la app (va como enlace en el correo).
APP_URL=http://localhost:8000

# --- Iniciar sesión con Google ---
# ID de cliente OAuth tipo "Aplicación web" (console.cloud.google.com > APIs y servicios > Credenciales).
# Orígenes autorizados: http://localhost:8000 (y tu dominio https cuando la publiques).
GOOGLE_CLIENT_ID=
# Clave para firmar las sesiones. Si la dejas vacía se crea sola en el archivo .secret_key.
SECRET_KEY=
# Días que dura una sesión iniciada.
TOKEN_DAYS=7
# Presupuesto de preguntas por diagnóstico.
MAX_QUESTIONS=18
QUESTIONS_PER_SUBTOPIC=3

# ---- Base de datos ----
# Por defecto: SQLite en ./ratio.db (no requiere instalar nada).
# Producción: DATABASE_URL=postgresql+psycopg://ratio:ratio@localhost:5432/ratio
# DATABASE_URL=

# ---- IA (opcional). Cualquier proveedor compatible con la API de OpenAI ----
# Sin estas variables la app funciona con el banco curado y calificación por rúbrica.
#
# Google Gemini (nivel gratuito; clave en https://aistudio.google.com). Copia el nombre
# exacto del modelo Flash que aparece en AI Studio.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=tu_clave_gemini
# AI_MODEL_GENERATOR=gemini-2.5-flash
#
# Verificador independiente (opcional). Si no lo defines, usa el mismo modelo del generador
# en una llamada separada. Ejemplo con Groq (gratuito y muy rápido):
# AI_VERIFIER_BASE_URL=https://api.groq.com/openai/v1
# AI_VERIFIER_API_KEY=tu_clave_groq
# AI_MODEL_VERIFIER=openai/gpt-oss-120b

# ---- Comportamiento de la IA ----
# Generar y verificar preguntas en vivo al iniciar cada diagnóstico (con caché).
AI_LIVE_GENERATION=true
# Permitir que la persona escriba un tema libre (la IA arma el mapa del tema).
AI_FREE_TOPIC=true
# Buscar fuentes en Google al armar un tema libre (solo con Gemini).
AI_WEB_SEARCH=true
# Usar primero las preguntas generadas por IA (las curadas quedan de respaldo).
AI_PREFER_GENERATED=true
# IA adaptativa durante el diagnóstico: cada AI_BATCH_EVERY respuestas genera AI_BATCH_SIZE preguntas
# para AI_BATCH_TARGETS subtema(s), según el perfil y los errores detectados; máximo AI_MAX_BATCHES lotes.
# Los valores por defecto caben en el plan gratuito de Groq (~14 diagnósticos con IA al día).
AI_BATCH_SIZE=3
AI_BATCH_EVERY=3
AI_BATCH_TARGETS=1
AI_MAX_BATCHES=4
# Preguntas verificadas por subtema que deja el comando de precarga (pregenerar).
AI_QUESTIONS_PER_SUBTOPIC=6
# Llamadas simultáneas a la IA (el plan gratuito limita las llamadas por minuto).
AI_MAX_CONCURRENCY=3
# Forzar IPv4 si la red tiene IPv6 roto (cada conexión tarda ~20 s). Lo detecta: python -m app.ai.check --red
AI_FORCE_IPV4=false
# Segundos máximos por llamada.
AI_TIMEOUT=90
# Razonamiento del modelo: minimal, low, medium o high. "low" responde mucho más rápido.
# Déjalo vacío para usar el valor por defecto del modelo.
AI_REASONING_EFFORT=low
